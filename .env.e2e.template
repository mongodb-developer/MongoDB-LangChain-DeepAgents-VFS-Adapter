# Copy this file to .env.e2e and fill in real values before running:
#   cp .env.e2e.template .env.e2e
#   set -a && source .env.e2e && set +a
#   pytest -m real_e2e -v

# MongoDB Atlas connection string (M10+ cluster required for vector search)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# S3 bucket (must exist; tests will write/delete objects under the prefix below)
S3_BUCKET_NAME=my-real-bucket
S3_TEST_PREFIX=langchain_mongodb_fs_e2e_test/

# ---------------------------------------------------------------------------
# AWS authentication — choose ONE of the three options below
# ---------------------------------------------------------------------------

# Option A: Long-term IAM user credentials (simplest, not recommended for prod)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Option B: STS temporary credentials (AssumeRole / SSO / federated identity)
# Obtain with: aws sts assume-role --role-arn <arn> --role-session-name e2e-test
# Then fill in all three fields — boto3 requires the session token alongside
# the temporary key/secret or requests will fail with InvalidClientTokenId.
# AWS_ACCESS_KEY_ID=ASIA...          # starts with ASIA for STS creds
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...              # required for STS — omit for long-term keys
# AWS_DEFAULT_REGION=us-east-1

# Option C: Named AWS profile (credentials already in ~/.aws/credentials)
# Leave all AWS_* vars above unset and set this instead:
# AWS_PROFILE=my-profile

# ---------------------------------------------------------------------------
# Embedding provider — choose ONE
# ---------------------------------------------------------------------------

# Option 1: OpenAI  (pip install deepagents_mongodb_fs[openai])
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small   # optional override

# Option 2: AWS Bedrock  (pip install deepagents_mongodb_fs[bedrock])
# Uses the boto3 credential chain above — no extra key needed.
# EMBEDDING_PROVIDER=bedrock
# EMBEDDING_MODEL=amazon.titan-embed-text-v2:0   # optional override
